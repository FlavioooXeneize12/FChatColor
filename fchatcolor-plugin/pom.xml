<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.fchatcolor</groupId>
        <artifactId>fchatcolor-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>fchatcolor-plugin</artifactId>
    <name>FChatColor-Plugin</name>
    <description>Main module: plugin, commands, configuration and JDBC storage (MySQL/SQLite).</description>

    <dependencies>
        <dependency>
            <groupId>io.github.fchatcolor</groupId>
            <artifactId>fchatcolor-api</artifactId>
        </dependency>

        <!-- Packed into the final jar, but only loaded via reflection
             when ServerDetector says so (never on 1.8). -->
        <dependency>
            <groupId>io.github.fchatcolor</groupId>
            <artifactId>fchatcolor-legacy</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.fchatcolor</groupId>
            <artifactId>fchatcolor-modern</artifactId>
        </dependency>

        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
        </dependency>

        <!-- PlaceholderAPI expansion (%fchatcolor_color%). Provided: the
             user must have PlaceholderAPI installed to use it. -->
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
        </dependency>

        <!-- JDBC drivers embedded. Not relocated: drivers use META-INF/services
             for auto-registration and java.sql.DriverManager won't find relocated classes. -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>FChatColor-${project.version}</finalName>

        <resources>
            <!-- plugin.yml is filtered to inject the project version -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>plugin.yml</include>
                    <include>paper-plugin.yml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>plugin.yml</exclude>
                    <exclude>paper-plugin.yml</exclude>
                </excludes>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>io.github.fchatcolor.FChatColorPlugin</mainClass>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
